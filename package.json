{
	"name": "electrobun-vue",
	"version": "1.0.0",
	"type": "module",
	"description": "Electrobun app with Vue and Vite HMR",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary"
	},
	"dependencies": {
		"electrobun": "^1.18.1"
	},
	"devDependencies": {
		"@arco-design/web-vue": "^2.58.0",
		"@types/bun": "latest",
		"@vitejs/plugin-vue": "^5.2.4",
		"concurrently": "^9.2.1",
		"typescript": "^5.9.3",
		"vite": "^6.4.2",
		"vue": "^3.5.34",
		"vue-router": "5.0.6",
		"vue-tsc": "^2.2.12"
	}
}
